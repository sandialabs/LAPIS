      linalg.yield %3 : f64
    } -> tensor<8xf64>
    %1 = linalg.generic {indexing_maps = [#map3, #map3, #map4], iterator_types = ["reduction"]} ins(%arg1, %0 : tensor<8xf64>, tensor<8xf64>) outs(%cst_0 : tensor<f64>) attrs =  {lapis.algebraic_fusion_group = 0 : i64} {
