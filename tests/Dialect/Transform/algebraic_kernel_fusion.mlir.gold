#map = affine_map<(d0, d1) -> (d0, d1)>
#map1 = affine_map<(d0, d1) -> (d1)>
#map2 = affine_map<(d0, d1) -> (d0)>
module {
  func.func @abx(%arg0: tensor<2x3xf32>, %arg1: tensor<3x5xf32>, %arg2: tensor<5xf32>) -> tensor<2xf32> {
    %cst = arith.constant dense<0.000000e+00> : tensor<2x5xf32>
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<2xf32>
    %0 = tensor.empty() : tensor<3xf32>
    %cst_1 = arith.constant 0.000000e+00 : f32
    %1 = linalg.fill ins(%cst_1 : f32) outs(%0 : tensor<3xf32>) -> tensor<3xf32>
    %2 = linalg.generic {indexing_maps = [#map, #map1, #map2], iterator_types = ["parallel", "reduction"]} ins(%arg1, %arg2 : tensor<3x5xf32>, tensor<5xf32>) outs(%1 : tensor<3xf32>) attrs =  {lapis.algebraic_fusion_group = 0 : i64} {
    ^bb0(%in: f32, %in_2: f32, %out: f32):
      %4 = arith.mulf %in, %in_2 : f32
      %5 = arith.addf %out, %4 : f32
      linalg.yield %5 : f32
    } -> tensor<3xf32>
    %3 = linalg.generic {indexing_maps = [#map, #map1, #map2], iterator_types = ["parallel", "reduction"]} ins(%arg0, %2 : tensor<2x3xf32>, tensor<3xf32>) outs(%cst_0 : tensor<2xf32>) attrs =  {lapis.algebraic_fusion_group = 0 : i64} {
    ^bb0(%in: f32, %in_2: f32, %out: f32):
      %4 = arith.mulf %in, %in_2 : f32
      %5 = arith.addf %out, %4 : f32
